# Local-only or regenerated artifacts. Frozen releases stay tracked.
#
# The rule is "evidence is tracked, bulk is not": locks, manifests, checksums, result JSON and
# figures are committed; raw images, embeddings, checkpoints and the frozen Version 1.0 archive
# are not. Nothing that was tracked before the 2026-09-23 layout normalisation is ignored here.

# --- Python caches and environments ---
__pycache__/
*.py[cod]
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/
env/
.env
.env.*

# --- IDE and operating-system files ---
.idea/
.vscode/
.DS_Store
Thumbs.db
Desktop.ini
*.tmp
*.log

# --- Version 1.0 locked inputs and generated media stay local ---
# The provenance probes, protocol metadata and evidence JSON are tracked because active scripts
# and the audit depend on them.
/data/v1.0/*
!/data/v1.0/provenance/
!/data/v1.0/audit.json
!/data/v1.0/manifest.json
!/data/v1.0/protocol.json
!/data/v1.0/protocol.sha256
!/data/v1.0/test_manifest.json
!/data/v1.0/variant_hashes.json

# --- Downloaded or derived bulk data (all releases) ---
/data/v2.0/raw/
/data/v2.0/processed/
/data/v2.0/embeddings/
/data/v2.1/raw/
/data/v2.1/processed/
/data/v2.1/embeddings/

# --- Version 1.0 site, report and historical working copies ---
/archive/
/site/
/report/
/docs/session/session-transcript.json
/docs/session/session-transcript.md

# --- Private iNaturalist metadata: aggregates only are published ---
# The audited release archive contains path-redacted public equivalents.
/data/v2.0/manifests/inat_birds_lock.json
/data/v2.0/manifests/inat_birds_lock.sha256
/data/v2.0/manifests/inat_birds_images.jsonl
/data/v2.0/manifests/inat_birds_images_lock.json
/data/v2.0/manifests/inat_birds_images_lock.sha256
/data/v2.0/manifests/inat_birds_train.jsonl
/data/v2.0/manifests/inat_birds_validation.jsonl
/data/v2.0/manifests/inat_birds_test.jsonl
/data/v2.0/manifests/inat_birds_unknown_development.jsonl
/data/v2.0/manifests/inat_birds_unknown_test.jsonl

# --- Large binaries and in-flight run state ---
/results/v1.0/*
!/results/v1.0/*.json
!/results/v1.0/ood/
/results/v1.0/ood/*
!/results/v1.0/ood/*.json
!/results/v1.0/report_review/
/results/v1.0/report_review/*
!/results/v1.0/report_review/*.json
/results/v2.0/**/*.npy
/results/v2.0/**/*.npz
/results/v2.0/**/*.pt
/results/v2.0/**/*.pth
/results/v2.0/**/*.faiss
/results/v2.0/**/*partial.json
/results/v2.0/sop/retrieval-superseded-undertrained-ivf.json
/results/v2.1/**/*.npz
/results/v2.1/**/*.npy
/results/v2.1/**/*.pt
/results/v2.1/**/*partial.json

# --- Generic model/index/archive outputs ---
*.ckpt
*.onnx
*.safetensors
*.faiss
*.fvecs
*.ivecs
*.tar
*.tar.gz
*.7z
*.zip

# --- Frozen release archives are published on purpose ---
!/releases/2.0/Assignment1-2.0.zip
!/releases/2.1/Assignment1-2.1.zip
# 1.0 is 740 MB, above the GitHub file limit; its checksum and manifest are tracked instead.
/releases/1.0/Assignment1-submission.zip

# --- Repository Quality Guard machine ledger ---
# The audit ledger is rewritten every round and carries its own SEM/ADD verdicts. Keeping it out of
# the tree stops the ledger from joining the change set it describes and from rehashing the semantic
# ids of its own report each round. Regenerate it locally with `audit`.
/修改说明.md
